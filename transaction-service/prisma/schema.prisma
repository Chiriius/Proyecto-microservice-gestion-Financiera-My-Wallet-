// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_POSTGRESQL_TRANSACTIONS")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

model User {
  id       String    @id @default(cuid())
  email    String    @unique
  token    String
  accounts Account[] // Relación uno a muchos con Account
}

model Account {
  id          String        @id @default(uuid())
  userId      String
  balance     Float
  accountName String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime?
  user        User           @relation(fields: [userId], references: [id]) // Relación con User
  transactions Transaction[] // Relación uno a muchos con Transaction
}

model Transaction {
  id              String   @id @default(uuid())
  accountId       String
  amount          Float
  transactionType String[]
  category        String
  description     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  account         Account  @relation(fields: [accountId], references: [id]) // Relación con Account
}